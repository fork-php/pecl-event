FROM redhat/ubi8

ARG SANITIZER=""
ENV SANITIZER="${SANITIZER}"

RUN dnf install -y \
    openssl \
    openssl-devel \
    openssl-libs \
    libevent \
    libevent-devel \
    php-cli \
    php-devel \
    make

WORKDIR /usr/src/pecl-event
COPY . .

RUN ./ci/build.sh
# `docker-php-ext-enable --ini-name z-event.ini event` is not available on this image
RUN echo 'extension=event.so' > /etc/php.d/z-event.ini

ENV NO_INTERACTION=1
CMD ["./ci/test.sh"]
